{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/personal-finance/model-instance.schema.json",
  "title": "Personal Finance Model Instance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_format_version",
    "financial_specification_version",
    "model_id",
    "objects"
  ],
  "properties": {
    "model_format_version": {
      "type": "string",
      "const": "0.2.0-draft",
      "description": "Version of this portable model envelope and object serialization contract."
    },
    "financial_specification_version": {
      "type": "string",
      "minLength": 1,
      "description": "Financial semantics/specification version under which the model was authored."
    },
    "model_id": {
      "type": "string",
      "format": "uuid"
    },
    "objects": {
      "$ref": "#/$defs/ModelInstance"
    }
  },
  "x-model-compatibility": {
    "current": "0.2.0-draft",
    "classifications": [
      "supported_directly",
      "migratable",
      "read_only_legacy",
      "unsupported"
    ],
    "legacy": {
      "0.1.0-draft": "read_only_legacy"
    },
    "migration_policy": "Explicit deterministic source-to-target migration chains only; no silent reinterpretation."
  },
  "$defs": {
    "Person": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "person_id": {
          "type": "string",
          "format": "uuid"
        },
        "first_name": {
          "type": "string"
        },
        "last_name": {
          "type": "string"
        },
        "date_of_birth": {
          "type": "string",
          "format": "date"
        },
        "date_of_death": {
          "type": "string",
          "format": "date"
        },
        "household_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "Household"
        },
        "relationship_status": {
          "type": "string",
          "enum": [
            "single",
            "married",
            "partnered",
            "divorced",
            "widowed",
            "other"
          ],
          "default": "single"
        },
        "employment_status": {
          "type": "string",
          "enum": [
            "employed",
            "unemployed",
            "retired",
            "self_employed",
            "student",
            "other"
          ],
          "default": "employed"
        },
        "residence_jurisdiction": {
          "type": "string"
        },
        "filing_status": {
          "type": "string",
          "enum": [
            "single",
            "married_joint",
            "married_separate",
            "head_of_household",
            "qualifying_widow_er"
          ]
        },
        "life_expectancy": {
          "type": "number"
        },
        "risk_profile": {
          "type": "string",
          "default": "moderate"
        }
      },
      "required": [
        "person_id",
        "first_name",
        "last_name",
        "date_of_birth",
        "employment_status",
        "residence_jurisdiction"
      ]
    },
    "Household": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "household_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "household_type": {
          "type": "string",
          "enum": [
            "individual",
            "couple",
            "family",
            "other"
          ],
          "default": "individual"
        },
        "formation_date": {
          "type": "string",
          "format": "date"
        },
        "dissolution_date": {
          "type": "string",
          "format": "date"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "primary_jurisdiction": {
          "type": "string"
        },
        "filing_status": {
          "type": "string",
          "enum": [
            "single",
            "married_joint",
            "married_separate",
            "head_of_household",
            "qualifying_widow_er"
          ]
        },
        "household_income": {
          "type": "number"
        },
        "household_expenses": {
          "type": "number"
        },
        "household_net_worth": {
          "type": "number"
        }
      },
      "required": [
        "household_id",
        "name",
        "household_type",
        "formation_date",
        "members",
        "primary_jurisdiction"
      ]
    },
    "Account": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "account_type": {
          "type": "string",
          "enum": [
            "checking",
            "savings",
            "cash",
            "taxable_brokerage",
            "traditional_401k",
            "roth_401k",
            "traditional_ira",
            "roth_ira",
            "hsa",
            "hsa_investment",
            "529",
            "403b",
            "457b",
            "sep_ira",
            "simple_ira",
            "pension",
            "cash_value_insurance",
            "other"
          ],
          "default": "cash"
        },
        "owner_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "Person|Household"
        },
        "institution": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "default": "USD"
        },
        "opening_date": {
          "type": "string",
          "format": "date"
        },
        "closing_date": {
          "type": "string",
          "format": "date"
        },
        "opening_balance": {
          "type": "number",
          "default": "0.0000"
        },
        "current_balance": {
          "type": "number",
          "default": "opening_balance"
        },
        "liquidity_class": {
          "type": "string",
          "enum": [
            "liquid",
            "semi_liquid",
            "illiquid",
            "restricted"
          ],
          "default": "liquid"
        },
        "tax_treatment": {
          "type": "string",
          "enum": [
            "taxable",
            "tax_deferred",
            "tax_free",
            "mixed",
            "inherited"
          ],
          "default": "taxable"
        },
        "contribution_limit_rule_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "TaxRule"
        },
        "withdrawal_rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "default": []
        },
        "fee_rule_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "TaxRule"
        },
        "return_model_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "PrimitiveInstance"
        },
        "transaction_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "default": []
        }
      },
      "required": [
        "account_id",
        "name",
        "account_type",
        "owner_id",
        "currency",
        "opening_date",
        "opening_balance",
        "current_balance",
        "liquidity_class",
        "tax_treatment"
      ]
    },
    "Asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "asset_type": {
          "type": "string",
          "enum": [
            "cash",
            "investment",
            "real_estate",
            "vehicle",
            "business",
            "personal_property",
            "other"
          ],
          "default": "other"
        },
        "owner_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "Person|Household"
        },
        "account_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "Account"
        },
        "acquisition_date": {
          "type": "string",
          "format": "date"
        },
        "acquisition_cost": {
          "type": "number"
        },
        "current_value": {
          "type": "number",
          "default": "acquisition_cost"
        },
        "valuation_method": {
          "type": "string",
          "enum": [
            "market",
            "appraisal",
            "cost",
            "formula",
            "custom"
          ],
          "default": "market"
        },
        "appreciation_model_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "PrimitiveInstance"
        },
        "depreciation_model_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "PrimitiveInstance"
        },
        "sale_date": {
          "type": "string",
          "format": "date"
        },
        "sale_cost": {
          "type": "number",
          "default": "0.0000"
        },
        "tax_basis": {
          "type": "number",
          "default": "acquisition_cost"
        },
        "liquidity_class": {
          "type": "string",
          "enum": [
            "liquid",
            "semi_liquid",
            "illiquid",
            "restricted"
          ],
          "default": "illiquid"
        }
      },
      "required": [
        "asset_id",
        "name",
        "asset_type",
        "owner_id",
        "current_value",
        "valuation_method",
        "liquidity_class"
      ]
    },
    "Liability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "liability_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "liability_type": {
          "type": "string",
          "enum": [
            "mortgage",
            "auto",
            "student",
            "credit_card",
            "personal",
            "heloc",
            "business",
            "tax",
            "other"
          ],
          "default": "other"
        },
        "owner_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "Person|Household"
        },
        "principal": {
          "type": "number"
        },
        "current_balance": {
          "type": "number",
          "default": "principal"
        },
        "interest_rate": {
          "type": "number",
          "default": "0.0"
        },
        "rate_type": {
          "type": "string",
          "enum": [
            "fixed",
            "variable",
            "indexed"
          ],
          "default": "fixed"
        },
        "payment_frequency": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "biweekly",
            "semimonthly",
            "monthly",
            "bimonthly",
            "quarterly",
            "semiannual",
            "annual",
            "irregular"
          ],
          "default": "monthly"
        },
        "scheduled_payment": {
          "type": "number"
        },
        "minimum_payment": {
          "type": "number",
          "default": "0.0000"
        },
        "extra_payment": {
          "type": "number",
          "default": "0.0000"
        },
        "origination_date": {
          "type": "string",
          "format": "date"
        },
        "maturity_date": {
          "type": "string",
          "format": "date"
        },
        "amortization_model_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "PrimitiveInstance"
        },
        "fee_rule_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "TaxRule"
        },
        "prepayment_rule_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "TaxRule"
        },
        "collateral_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "Asset"
        },
        "tax_treatment": {
          "type": "string",
          "enum": [
            "taxable",
            "tax_deferred",
            "tax_free",
            "mixed",
            "inherited"
          ],
          "default": "taxable"
        }
      },
      "required": [
        "liability_id",
        "name",
        "liability_type",
        "owner_id",
        "principal",
        "current_balance",
        "interest_rate",
        "rate_type",
        "payment_frequency",
        "origination_date"
      ]
    },
    "Income": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "income_id": {
          "type": "string",
          "format": "uuid"
        },
        "owner_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "Person|Household"
        },
        "income_type": {
          "type": "string",
          "enum": [
            "salary",
            "bonus",
            "commission",
            "overtime",
            "equity_compensation",
            "business",
            "rental",
            "interest",
            "dividend",
            "capital_gain",
            "pension",
            "social_security",
            "government_benefit",
            "unemployment",
            "severance",
            "gift",
            "inheritance",
            "other"
          ],
          "default": "salary"
        },
        "source": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "frequency": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "biweekly",
            "semimonthly",
            "monthly",
            "bimonthly",
            "quarterly",
            "semiannual",
            "annual",
            "irregular"
          ],
          "default": "annual"
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "growth_model_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "PrimitiveInstance"
        },
        "probability_model_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "PrimitiveInstance"
        },
        "tax_character": {
          "type": "string",
          "enum": [
            "ordinary",
            "qualified_dividend",
            "short_term_capital_gain",
            "long_term_capital_gain",
            "tax_free",
            "deferred",
            "other"
          ],
          "default": "ordinary"
        },
        "gross_or_net": {
          "type": "string",
          "default": "gross"
        },
        "related_event_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "Event"
        }
      },
      "required": [
        "income_id",
        "owner_id",
        "income_type",
        "amount",
        "frequency",
        "start_date",
        "tax_character",
        "gross_or_net"
      ]
    },
    "Expense": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expense_id": {
          "type": "string",
          "format": "uuid"
        },
        "owner_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "Person|Household"
        },
        "category": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "frequency": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "biweekly",
            "semimonthly",
            "monthly",
            "bimonthly",
            "quarterly",
            "semiannual",
            "annual",
            "irregular"
          ],
          "default": "monthly"
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "growth_model_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "PrimitiveInstance"
        },
        "essentiality": {
          "type": "string",
          "enum": [
            "essential",
            "discretionary"
          ],
          "default": "discretionary"
        },
        "tax_deductibility_rule_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "TaxRule"
        },
        "payment_account_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "Account"
        },
        "event_trigger_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "Event"
        }
      },
      "required": [
        "expense_id",
        "owner_id",
        "category",
        "amount",
        "frequency",
        "start_date"
      ]
    },
    "Transaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transaction_id": {
          "type": "string",
          "format": "uuid"
        },
        "transaction_date": {
          "type": "string",
          "format": "date-time"
        },
        "transaction_type": {
          "type": "string",
          "enum": [
            "income",
            "expense",
            "transfer",
            "investment_purchase",
            "investment_sale",
            "debt_draw",
            "debt_payment",
            "tax",
            "insurance_premium",
            "insurance_claim",
            "asset_purchase",
            "asset_sale",
            "gift",
            "inheritance",
            "conversion",
            "distribution",
            "contribution",
            "other"
          ],
          "default": "transfer"
        },
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "default": "USD"
        },
        "source_account_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "Account"
        },
        "destination_account_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "Account"
        },
        "cash_flow_class": {
          "type": "string",
          "enum": [
            "operating",
            "investing",
            "financing",
            "non_cash"
          ],
          "default": "operating"
        },
        "event_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "Event"
        },
        "scenario_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "Scenario"
        },
        "tax_effect": {
          "type": "number",
          "default": "0.0000"
        },
        "description": {
          "type": "string"
        },
        "legs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/AccountingLeg"
          }
        }
      },
      "required": [
        "transaction_id",
        "transaction_date",
        "transaction_type",
        "amount",
        "currency",
        "cash_flow_class",
        "scenario_id",
        "legs"
      ]
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "marriage",
            "divorce",
            "childbirth",
            "adoption",
            "death",
            "job_change",
            "promotion",
            "layoff",
            "unemployment_start",
            "unemployment_end",
            "retirement",
            "relocation",
            "home_purchase",
            "home_sale",
            "vehicle_purchase",
            "vehicle_sale",
            "education_start",
            "education_end",
            "medical_event",
            "inheritance",
            "gift",
            "business_creation",
            "business_sale",
            "insurance_claim",
            "refinance",
            "debt_issuance",
            "debt_payoff",
            "account_open",
            "account_close",
            "other"
          ],
          "default": "other"
        },
        "description": {
          "type": "string"
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "duration_days": {
          "type": "integer"
        },
        "trigger_type": {
          "type": "string",
          "enum": [
            "scheduled",
            "stochastic",
            "conditional",
            "dependency",
            "external"
          ],
          "default": "scheduled"
        },
        "trigger_condition": {
          "type": "string"
        },
        "probability_model_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "PrimitiveInstance"
        },
        "effect_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventDependency"
          },
          "default": []
        },
        "precedence": {
          "type": "integer",
          "default": 0
        },
        "scenario_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "Scenario"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "event_id",
        "name",
        "event_type",
        "start_date",
        "trigger_type",
        "effect_ids",
        "scenario_id",
        "enabled"
      ]
    },
    "Scenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "base_scenario_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "Scenario"
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "timestep": {
          "type": "string",
          "enum": [
            "daily",
            "monthly",
            "quarterly",
            "annual"
          ],
          "default": "monthly"
        },
        "assumption_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "default": []
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "default": []
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "stochastic": {
          "type": "boolean",
          "default": false
        },
        "simulation_count": {
          "type": "integer",
          "default": 1
        }
      },
      "required": [
        "scenario_id",
        "name",
        "start_date",
        "end_date",
        "timestep",
        "enabled",
        "stochastic"
      ]
    },
    "Assumption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assumption_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
