{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServerNotification",
  "oneOf": [
    {
      "type": "object",
      "required": ["method", "params"],
      "properties": {
        "method": { "type": "string", "enum": ["turn/completed"] },
        "params": { "$ref": "#/definitions/TurnCompletedNotification" }
      }
    },
    {
      "type": "object",
      "required": ["method", "params"],
      "properties": {
        "method": { "type": "string", "enum": ["thread/tokenUsage/updated"] },
        "params": { "$ref": "#/definitions/ThreadTokenUsageUpdatedNotification" }
      }
    }
  ],
  "definitions": {
    "TurnCompletedNotification": {
      "type": "object",
      "required": ["threadId", "turn"],
      "properties": { "threadId": { "type": "string" }, "turn": { "$ref": "#/definitions/Turn" } }
    },
    "ThreadTokenUsageUpdatedNotification": {
      "type": "object",
      "required": ["threadId", "turnId", "tokenUsage"],
      "properties": {
        "threadId": { "type": "string" },
        "turnId": { "type": "string" },
        "tokenUsage": { "$ref": "#/definitions/ThreadTokenUsage" }
      }
    },
    "Turn": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string" },
        "status": { "type": "string", "enum": ["completed", "interrupted", "failed"] }
      }
    },
    "ThreadTokenUsage": { "type": "object" }
  }
}
