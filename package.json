{
  "name": "personal-finance-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "spec:validate": "node tools/validate-specs.mjs",
    "architecture:validate": "node tools/validate-architecture.mjs",
    "test": "vitest run",
    "codex:test": "node tools/codex/quiet-vitest.mjs",
    "codex:tooling-test": "node tools/codex/tooling-self-test.mjs",
    "codex:verify": "node tools/codex/verify.mjs",
    "editor:generate": "node tools/generate-editor-descriptor.mjs",
    "editor:check": "node tools/generate-editor-descriptor.mjs --check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.next.json",
    "dev:web": "next dev",
    "build:web": "rm -rf dist out && next build && mv out dist && touch dist/.nojekyll",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "recharts": "3.10.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fast-check": "^4.9.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

