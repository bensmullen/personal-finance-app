{
  "name": "personal-finance-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "spec:validate": "node tools/validate-specs.mjs",
    "architecture:validate": "node tools/validate-architecture.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:web": "rm -rf dist && tsc -p tsconfig.web.json && mkdir -p dist && cp web/index.html web/styles.css dist/ && touch dist/.nojekyll"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
